---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { experience } from "../data/content";

const skins = ["bg-ink text-paper", "bg-accent text-ink", "bg-paper-2 text-ink"];
---

<Base>
  <main>
    <PageHead index="05" title="Experience" />

    <section class="mt-16 px-5 md:mt-24 md:px-10">
      <div data-stack class="grid gap-6">
        {
          experience.map((e, i) => (
            <article
              class={`sticky flex min-h-[44svh] origin-top flex-col justify-between rounded-[2rem] p-6 will-change-transform md:min-h-[48svh] md:p-10 ${skins[i % skins.length]}`}
              style={`top:${6 + i * 0.9}rem`}
            >
              <div class="flex items-start justify-between gap-6">
                <span class="mono opacity-70">{String(i + 1).padStart(2, "0")}</span>
                {e.when && <span class="mono rounded-full border border-current px-3.5 py-1.5">{e.when}</span>}
              </div>
              <div class="mt-10 grid gap-8 md:grid-cols-12 md:items-end">
                <div class="md:col-span-7">
                  <h2 class="display text-[clamp(2rem,5.2vw,4.8rem)] leading-[0.9]">{e.role}</h2>
                  <p class="serif mt-4 text-[clamp(1.2rem,2.2vw,1.9rem)]">{e.org}</p>
                </div>
                {e.points.length > 0 && (
                  <ul class="grid gap-2 text-[0.98rem] leading-snug font-medium md:col-span-5">
                    {e.points.map((pt) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-current" />
                        {pt}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Base>
