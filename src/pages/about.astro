---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Rail from "../components/Rail";
import { intro, education, achievements, gallery } from "../data/content";

const words = (s: string) => s.split(" ");
---

<Base>
  <main>
    <PageHead index="02" title="About Me" />

    <section class="mt-14 grid gap-12 px-5 md:mt-24 md:grid-cols-12 md:gap-16 md:px-10">
      <!-- portrait -->
      <div class="md:col-span-5">
        <div class="md:sticky md:top-28" data-reveal>
          <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[2rem] bg-paper-2">
            <img
              src={intro.image}
              alt="Murshida P."
              class="absolute bottom-0 left-1/2 h-[96%] w-auto max-w-none -translate-x-1/2"
            />
          </div>
          <div class="mono mt-4 flex items-center justify-between border-t border-ink/80 pt-3">
            <span>{intro.name}</span>
            <span class="opacity-60">{intro.role}</span>
          </div>
        </div>
      </div>

      <!-- story -->
      <div class="md:col-span-7">
        <p class="mono mb-6 flex items-center gap-3" data-reveal>
          <span class="inline-block size-2 rounded-full bg-ink"></span>
          Profile
        </p>
        <p
          data-words
          class="text-[clamp(1.6rem,3vw,2.7rem)] leading-[1.15] font-semibold tracking-tight"
        >
          {
            words(intro.paragraphs[0]).map((w) => (
              <>
                <span class="w">{w}</span>{" "}
              </>
            ))
          }
        </p>

        <div class="mt-12 grid gap-8 border-t border-ink/80 pt-8 text-[1.05rem] leading-relaxed sm:grid-cols-2 sm:gap-10" data-reveal>
          {intro.paragraphs.slice(1).map((p) => <p class="opacity-80">{p}</p>)}
        </div>

        <!-- at a glance -->
        <dl class="mt-14 border-t border-ink/80" data-reveal>
          {
            [
              ["Role", intro.role],
              ["Studying", `${education[0].title} · ${education[0].place}`],
              ["Stack", intro.skills.join(" · ")],
              ["Contact", intro.email],
            ].map(([k, v]) => (
              <div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-4 border-b border-ink/20 py-4 md:grid-cols-[9rem_1fr]">
                <dt class="mono opacity-60">{k}</dt>
                <dd class="text-lg font-semibold tracking-tight">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- education + achievements -->
    <section class="mt-24 grid gap-16 px-5 md:mt-36 md:grid-cols-2 md:gap-12 md:px-10">
      <div data-reveal>
        <p class="mono mb-2 border-b border-ink pb-3">Education</p>
        <ol>
          {
            education.map((e, i) => (
              <li class="row group grid grid-cols-[2.5rem_1fr] gap-4 border-b border-ink/20 py-7 transition-[padding] duration-500 ease-[var(--ease-expo)] hover:px-4">
                <span class="mono opacity-60">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="text-2xl leading-tight font-bold tracking-tight">{e.title}</p>
                  <p class="mt-1 opacity-70">{e.place}</p>
                  <p class="mono mt-3 inline-block rounded-full border border-ink/40 px-3 py-1">{e.when}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div data-reveal style="--d:.1s">
        <p class="mono mb-2 border-b border-ink pb-3">Achievements</p>
        <ul>
          {
            achievements.map((a, i) => (
              <li class="row group grid grid-cols-[2.5rem_1fr] gap-4 border-b border-ink/20 py-7 transition-[padding] duration-500 ease-[var(--ease-expo)] hover:px-4">
                <span class="mono opacity-60">★ {String(i + 1).padStart(2, "0")}</span>
                <p class="text-2xl leading-tight font-bold tracking-tight">{a}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mt-28 md:mt-40">
      <div class="mono mb-6 flex items-center justify-between px-5 md:px-10" data-reveal>
        <span>Moments · {String(gallery.length).padStart(2, "0")}</span>
        <span class="opacity-60">Drag →</span>
      </div>
      <div data-reveal>
        <Rail client:visible items={gallery} />
      </div>
    </section>
  </main>
</Base>
