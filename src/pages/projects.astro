---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { projects } from "../data/content";
---

<Base>
  <main>
    <PageHead index="04" title="Projects" />

    <section class="mt-16 grid gap-24 px-5 md:mt-24 md:px-10">
      {
        projects.map((p, i) => (
          <article class="grid gap-10 md:grid-cols-12 md:gap-12">
            <a
              href={`https://${p.url}`}
              target="_blank"
              rel="noreferrer"
              data-cursor
              class="group relative block aspect-[5/4] overflow-hidden rounded-[2rem] bg-ink md:col-span-7"
              data-reveal
            >
              <div class="absolute inset-0 bg-accent transition-transform duration-[1100ms] ease-[var(--ease-expo)] [clip-path:circle(38%_at_72%_30%)] group-hover:scale-[1.35]" />
              <p class="display absolute bottom-6 left-6 max-w-[80%] text-[clamp(2rem,5.5vw,4.6rem)] text-paper">
                {p.title}
              </p>
              <span class="mono absolute top-6 left-6 text-paper">{p.url}</span>
              <span class="absolute top-5 right-5 grid size-12 place-items-center rounded-full bg-paper text-xl transition-transform duration-500 group-hover:rotate-45">
                ↗
              </span>
            </a>

            <div class="flex flex-col justify-between gap-10 md:col-span-5">
              <div data-reveal style="--d:.1s">
                <p class="mono mb-6">
                  Project {String(i + 1)} of {projects.length}
                </p>
                <h2 class="font-exo text-[clamp(2rem,4vw,3.4rem)] leading-[1.02] font-bold tracking-tight">
                  {p.title}
                </h2>
                <ul class="mt-6 flex flex-wrap gap-2">
                  {p.stack.map((s) => (
                    <li class="mono rounded-full border border-ink/80 px-3.5 py-1.5">{s}</li>
                  ))}
                </ul>
              </div>
              <p class="text-lg leading-relaxed font-medium" data-reveal style="--d:.2s">
                {p.description}
              </p>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</Base>
